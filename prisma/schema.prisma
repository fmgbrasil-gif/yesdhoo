// Para producao com Postgres (ex.: Supabase), troque provider para "postgresql".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String   @id @default(uuid())
  name       String
  planScreens Int     @default(10)
  createdAt  DateTime @default(now())
  // --- plataforma (aluguel do sistema para outras empresas) ---
  isPlatform     Boolean   @default(false) // a conta dona do sistema
  slug           String?   @unique         // endereco de login personalizado: /login?empresa=slug
  document       String?                   // CNPJ
  tradeName      String?                   // nome fantasia
  stateRegistration String?                // inscricao estadual
  email          String?
  phone          String?
  folder         String   @default("{}") // JSON do folder promocional (capa, textos, planos, logos, contato)
  road           String?
  number         String?
  complement     String?
  neighborhood   String?
  zipcode        String?
  city           String?
  state          String?
  invoiceTitle   String    @default("FATURA DE SERVIÇOS")
  invoiceNature  String    @default("VEICULAÇÃO DE MÍDIA INDOOR")
  invoiceFiscal  String    @default("")    // informacoes fiscais no rodape da fatura
  logo           String?
  color          String    @default("#8a52f8") // cor da marca no painel (padrao: violeta da Yes)
  status         String    @default("ativo")   // ativo | bloqueado
  blockedReason  String?
  blockedAt      DateTime?
  blockedAuto    Boolean   @default(false)     // bloqueio feito pelo sistema por atraso
  autoBlockDays  Int?                          // bloquear sozinho apos N dias de fatura vencida
  billingClientId String?  @unique             // cliente que representa esta empresa na conta da plataforma
  // --- cobranca desta empresa para os clientes dela ---
  pixKey         String?
  pixName        String?
  pixCity        String?
  bankProvider   String?                       // asaas
  bankEnv        String    @default("sandbox") // sandbox | producao
  bankApiKey     String?                       // criptografada
  bankWebhookToken String?
  aiApiKey       String?   // chave da OpenAI (ChatGPT) para contratos com IA, criptografada
  invoiceSeq     Int       @default(0)
  invoiceNotes   String    @default("")
  users      User[]
  invoices   Invoice[]
  subscriptions Subscription[]
  contracts  Contract[]
  services   Service[]
  operations Operation[]
  bankAccounts BankAccount[]
  cashEntries  CashEntry[]
  payables     Payable[]
  payableSeries PayableSeries[]
  savedOptions SavedOption[]
  screens    Screen[]
  clients    Client[]
  medias     Media[]
  groups     MediaGroup[]
  notifications Notification[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  image        String?
  timezone     String   @default("America/Sao_Paulo")
  role         String   @default("admin") // admin | operador
  superAdmin   Boolean  @default(false)   // dono da plataforma: cria e bloqueia empresas
  restricted   Boolean  @default(false)   // restringe acesso a conteudos privados
  active       Boolean  @default(true)
  notes        String   @default("")
  createdAt    DateTime @default(now())
  // seguranca de acesso
  sessionVersion     Int       @default(0)     // muda ao trocar a senha: derruba as sessoes antigas
  mustChangePassword Boolean   @default(false) // senha provisoria: obriga a troca no primeiro acesso
  lastLoginAt        DateTime?
  screens      UserScreen[]
  commands     Command[]
}

// Controle de tentativas (login por e-mail/IP e pareamento por IP) para barrar forca bruta
model Throttle {
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

// Permissao de telas por usuario (vazio = todas)
model UserScreen {
  userId   String
  screenId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  @@id([userId, screenId])
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  screens Screen[]
  medias  Media[]
}

model Client {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         String   @default("PJ") // PF | PJ
  kind         String   @default("cliente") // cliente (anunciante) | parceiro (ponto onde fica a tela)
  document     String?
  name         String
  tradeName    String?  // nome fantasia
  stateRegistration String?
  email        String?
  phone1       String?
  phone2       String?
  image        String?
  road         String?
  number       String?
  complement   String?
  neighborhood String?
  zipcode      String?
  city         String?
  state        String?
  monthlyFeeCents Int?    // legado: mensalidade antiga, migrada para Subscription
  dueDay       Int?       // legado
  active       Boolean  @default(true) // inativo: as midias dele param de rodar nas telas
  deactivatedAt DateTime?
  bankCustomerId String?  // cadastro do cliente no banco integrado
  createdAt    DateTime @default(now())
  medias       Media[]
  screens      Screen[]
  invoices     Invoice[]
  subscriptions Subscription[]
  contracts    Contract[]
}

// Cobranca que gera faturas mes a mes: por periodo (N meses, todas geradas de uma vez) ou recorrente (ate cancelar).
model Subscription {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  mode         String    // periodo | recorrente
  items        String    @default("[]")
  amountCents  Int
  dueDay       Int
  startMonth   String    // YYYY-MM
  months       Int?      // so no modo periodo
  status       String    @default("ativa") // ativa | cancelada
  cancelledAt  DateTime?
  cancelReason String?
  notes        String    @default("")
  operationId  String?
  operation    Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  accountId    String?   // caixa que recebe os pagamentos (escolhido na cobranca)
  account      BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  invoices     Invoice[]
  contracts    Contract[]
  @@index([tenantId, status])
}

// Contrato de prestacao de servicos (redigido com IA a partir dos dados do cliente e da cobranca).
model Contract {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  title          String
  body           String
  operationId    String?
  operation      Operation?    @relation(fields: [operationId], references: [id], onDelete: SetNull)
  publicToken    String?       @unique // link publico para o cliente ver e baixar o contrato
  signStatus     String        @default("pendente") // pendente | assinado | recusado (assinatura eletronica pelo link)
  signedAt       DateTime?
  signerName     String?
  signerDoc      String?
  signature      String?       // rubrica desenhada pelo cliente (PNG em data URL)
  signerIp       String?
  signerAgent    String?
  bodyHash       String?       // SHA-256 do texto no momento da assinatura
  refusedAt      DateTime?
  refuseReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// Operacao: conjunto de pontos (telas) que um contrato contempla, ex.: "Rede Delta"
model Operation {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String         @default("")
  screens       Screen[]
  contracts     Contract[]
  subscriptions Subscription[]
  invoices      Invoice[]
  accountId     String?        // conta corrente que recebe os pagamentos desta operacao (ex.: Caixa SkyFit)
  account       BankAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  @@index([tenantId])
}

// Catalogo de servicos prestados (atalho para preencher os itens das cobrancas).
model Service {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  unit       String   @default("mês")
  priceCents Int
  createdAt  DateTime @default(now())
  @@index([tenantId])
}

// Fatura (conta a receber). Valores em centavos.
model Invoice {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  number       Int
  items        String    @default("[]") // JSON: [{ description, quantity, unitCents }]
  amountCents  Int
  dueDate      String    // YYYY-MM-DD
  competence   String?   // YYYY-MM quando gerada por uma cobranca recorrente ou por periodo
  subscriptionId String?
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  installment  Int?      // numero da parcela (modo periodo)
  status       String    @default("aberta") // aberta | paga | cancelada
  paidAt       DateTime?
  paidCents    Int?
  paymentMethod String?  // pix | boleto | dinheiro | transferencia | cartao
  notes        String    @default("")
  publicToken  String    @unique // link da fatura para o cliente pagar
  txid         String
  bankChargeId String?
  boletoUrl    String?
  boletoLine   String?
  bankPixPayload String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  operationId  String?
  operation    Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  accountId    String?   // caixa que recebe o pagamento desta fatura
  account      BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  @@unique([tenantId, number])
  @@unique([subscriptionId, competence])
  @@index([tenantId, status, dueDate])
}

model Screen {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  image           String?
  orientation     String    @default("H") // H | V
  rotation        String    @default("auto") // auto | 0 | 90 | 180 | 270 (giro da imagem no aparelho)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  phone1          String?
  phone2          String?
  road            String?
  number          String?
  complement      String?
  neighborhood    String?
  zipcode         String?
  city            String?
  state           String?
  latitude        Float?
  longitude       Float?
  workStart       String?   // HH:MM
  workEnd         String?
  weekDays        String    @default("") // "0,1,2..." (0 = domingo); vazio = todos
  avgFlow         Int?      // fluxo medio de pessoas/dia
  timezone        String    @default("America/Sao_Paulo")
  updateFrequency Int       @default(10) // minutos
  audioEnabled    Boolean   @default(false)
  footerEnabled   Boolean   @default(false)
  footerText      String    @default("Anuncie aqui")
  footerBg        String    @default("#000000")
  footerColor     String    @default("#FFFFFF")
  footerClock     Boolean   @default(true)
  footerWeather   Boolean   @default(false)
  favorite        Boolean   @default(false)
  // relatorio promocional dos pontos
  companyName     String?   // nome completo da empresa do ponto
  promoText       String    @default("") // descricao do ponto para o relatorio
  photos          String    @default("[]") // JSON: fotos do ponto (chaves de arquivo)
  promoInclude    Boolean   @default(true) // aparece no relatorio promocional
  notes           String    @default("")
  // pareamento / dispositivo
  pairingCode     String    @unique
  deviceToken     String?   @unique
  deviceInfo      String    @default("{}") // JSON com modelo, SO, versao do app etc.
  lastSeenAt      DateTime?
  syncedAt        DateTime?
  playlistVersion Int       @default(1)
  syncedVersion   Int       @default(0)
  screenshot      String?
  screenshotAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  items           PlaylistItem[]
  commands        Command[]
  stats           PlayStat[]
  uptime          ScreenUptime[]
  users           UserScreen[]
  operations      Operation[]
}

// Conteudo reproduzivel. tenantId nulo = biblioteca global (conteudos dinamicos).
model Media {
  id           String    @id @default(uuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // arquivo | youtube | link | aviso | rss | hora | dolar | clima
  type         String    @default("arquivo")
  library      String?   // secao da biblioteca: marca | saude | sazonais | noticias | diversos
  name         String
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  kind         String?   // image | video (para type=arquivo)
  fileH        String?   // arquivo horizontal
  fileV        String?   // arquivo vertical
  thumb        String?
  url          String?   // youtube / link / feed rss
  config       String    @default("{}") // JSON: cores, textos, fonte etc.
  duration     Int       @default(15)   // segundos
  size         Int?      // bytes
  width        Int?
  height       Int?
  storeStats   Boolean   @default(true)
  active       Boolean   @default(true)
  // agendamento
  startDate    String?   // YYYY-MM-DD
  endDate      String?
  shiftStart   String?   // HH:MM
  shiftEnd     String?
  weekDays     String    @default("")
  notes        String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  items        PlaylistItem[]
  groupItems   MediaGroupItem[]
  stats        PlayStat[]
}

model MediaGroup {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  image     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  medias    MediaGroupItem[]
  items     PlaylistItem[]
}

model MediaGroupItem {
  groupId  String
  mediaId  String
  position Int        @default(0)
  group    MediaGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  media    Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  @@id([groupId, mediaId])
}

// Um item da playlist aponta para uma midia OU para um grupo (que alterna suas midias a cada ciclo).
model PlaylistItem {
  id       String      @id @default(uuid())
  screenId String
  screen   Screen      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  mediaId  String?
  media    Media?      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  groupId  String?
  group    MediaGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  position Int
  @@index([screenId, position])
}

model Command {
  id         String    @id @default(uuid())
  screenId   String
  screen     Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  type       String    // recarregar | sincronizar | screenshot | limpar_cache
  status     String    @default("pendente") // pendente | executado
  createdAt  DateTime  @default(now())
  executedAt DateTime?
  @@index([screenId, status])
}

// Comprovacao de exibicao agregada por dia
model PlayStat {
  screenId String
  mediaId  String
  date     String // YYYY-MM-DD
  count    Int    @default(0)
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  @@id([screenId, mediaId, date])
  @@index([date])
}

// Minutos online por dia (alimentado pelo heartbeat do player)
model ScreenUptime {
  screenId String
  date     String
  minutes  Int    @default(0)
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  @@id([screenId, date])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String?  // evita duplicidade
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@unique([tenantId, key])
}

// Conta corrente: caixa, banco ou carteira digital. Saldo = saldo inicial + entradas - saidas.
model BankAccount {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  kind         String      @default("banco") // caixa | banco | carteira
  bank         String?     // nome do banco / agencia e conta (texto livre)
  initialCents Int         @default(0)
  isDefault    Boolean     @default(false) // recebe as baixas automaticas (boleto pago no banco)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  entries      CashEntry[]
  payables     Payable[]
  operations   Operation[]
  invoices     Invoice[]
  subscriptions Subscription[]
  @@index([tenantId])
}

// Lancamento do extrato (entrada ou saida). Recebimentos de fatura e pagamentos de contas geram lancamentos sozinhos.
model CashEntry {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId   String
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date        String      // YYYY-MM-DD
  kind        String      // entrada | saida
  amountCents Int         // sempre positivo
  description String
  category    String      @default("")
  invoiceId   String?     // recebimento de fatura
  payableId   String?     // pagamento de conta a pagar
  transferId  String?     // as duas pontas de uma transferencia entre contas
  createdAt   DateTime    @default(now())
  @@index([tenantId, date])
  @@index([accountId, date])
  @@index([invoiceId])
  @@index([payableId])
}

// Conta a pagar (despesa). Pode ser uma serie mensal (groupId + parcela).
model Payable {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  description  String
  supplier     String?
  category     String       @default("Outros")
  amountCents  Int
  dueDate      String       // YYYY-MM-DD
  status       String       @default("aberta") // aberta | paga | cancelada
  paidAt       String?
  paidCents    Int?
  accountId    String?
  account      BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  notes        String       @default("")
  groupId      String?
  installment  Int?
  installments Int?
  seriesId     String?        // despesa fixa mensal (recorrente)
  series       PayableSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  competence   String?        // AAAA-MM da recorrencia
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@index([tenantId, status, dueDate])
  @@unique([seriesId, competence])
}

// Despesa fixa mensal (aluguel, internet...): mantem 12 contas lancadas a frente ate ser cancelada.
model PayableSeries {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  description String
  supplier    String?
  category    String    @default("Outros")
  amountCents Int
  dueDay      Int       // 1 a 31 (meses menores usam o ultimo dia)
  startMonth  String    // AAAA-MM
  notes       String    @default("")
  status      String    @default("ativa") // ativa | cancelada
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  payables    Payable[]
  @@index([tenantId, status])
}

// Opcoes cadastradas pelo botao + dos campos (descricoes de lancamento, categorias, fornecedores...).
model SavedOption {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String   // lancamento | despesa | categoria | fornecedor
  value     String
  createdAt DateTime @default(now())
  @@unique([tenantId, kind, value])
}

// Chave de assinatura do app Android (e outras chaves da plataforma). Arquivo e senha criptografados
// com SIGNING_KEY_SECRET (configuracao do servidor). So o administrador da plataforma ve.
model SigningKey {
  id           String   @id @default(uuid())
  name         String   @unique // ex.: android
  alias        String
  fileName     String
  keystoreEnc  String   // arquivo da chave (base64) criptografado
  passwordEnc  String   // senha criptografada (mesma para o arquivo e a chave)
  sha256       String   // impressao digital do certificado (conferir assinatura dos APKs)
  validUntil   String?
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
