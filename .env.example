# Banco de dados (SQLite local). Para Postgres/Supabase, troque o provider em prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Segredo usado para assinar a sessao (troque em producao)
AUTH_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"

# --- Producao ---
# Conta inicial criada na primeira subida (a senha e provisoria: o sistema obriga a troca no 1o acesso)
# ADMIN_EMAIL="voce@suaempresa.com.br"
# ADMIN_PASSWORD="uma-senha-provisoria-forte"
# TENANT_NAME="Yes Mídia Indoor"
# PLAN_SCREENS=50
# Onde gravar as midias enviadas (aponte para um volume persistente)
# STORAGE_DIR="/data/storage"
